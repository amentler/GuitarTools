ep 4: instantiate and return\n    return new EssentiaClass(wasmModule);\n  })", "is_member_call": false, "source_file": "/home/azureuserhauptmann/privat/GuitarToolsALT/tests/helpers/essentiaNodeWasmLoader.js", "source_location": "L61"}, {"caller_nid": "helpers_essentianodewasmloader_loadessentiafornode", "callee": "catch", "is_member_call": true, "source_file": "/home/azureuserhauptmann/privat/GuitarToolsALT/tests/helpers/essentiaNodeWasmLoader.js", "source_location": "L104"}]}