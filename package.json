{
  "name": "guitartools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:precommit && npm run test:audio:slow",
    "test:unit": "vitest run tests/unit --exclude 'tests/unit/pitchLogic.test.js' --exclude 'tests/unit/tunerAudio.test.js' --exclude 'tests/unit/fastNoteMatcherAudio.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.fast.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.medium.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.slow.test.js' --exclude 'tests/unit/sheetMusicSequenceFingerprint.test.js' --exclude 'tests/unit/sheetMusicNoteFingerprint.test.js' --exclude 'tests/unit/sheetMusicReadingRecognition.test.js' --exclude 'tests/unit/notePlayingAudioRegression.test.js' --exclude 'tests/unit/d3SubharmonicRegression.test.js' --exclude 'tests/unit/essentiaChordAudio.test.js' --exclude 'tests/unit/essentiaBassScore.test.js' --exclude 'tests/unit/essentiaChordDirectWav.test.js' --exclude 'tests/unit/essentiaChordTargetedRegression.test.js' --exclude 'tests/unit/essentiaChordJsfingerprintMetrics.test.js' --exclude 'tests/unit/essentiaChordConfusionMetrics.test.js' --exclude 'tests/unit/essentiaChordExtractionSnapshot.test.js'",
    "test:precommit": "npm run test:unit",
    "test:audio:goldens": "vitest run tests/unit/sheetMusicNoteFingerprint.test.js",
    "test:sync": "npm run test:precommit && npm run test:audio:goldens",
    "test:staged": "vitest related --run --passWithNoTests --exclude 'tests/unit/pitchLogic.test.js' --exclude 'tests/unit/tunerAudio.test.js' --exclude 'tests/unit/fastNoteMatcherAudio.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.fast.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.medium.test.js' --exclude 'tests/unit/fastNoteMatcherSequence.slow.test.js' --exclude 'tests/unit/sheetMusicSequenceFingerprint.test.js' --exclude 'tests/unit/sheetMusicNoteFingerprint.test.js' --exclude 'tests/unit/sheetMusicReadingRecognition.test.js' --exclude 'tests/unit/notePlayingAudioRegression.test.js' --exclude 'tests/unit/d3SubharmonicRegression.test.js' --exclude 'tests/unit/essentiaChordAudio.test.js' --exclude 'tests/unit/essentiaBassScore.test.js' --exclude 'tests/unit/essentiaChordDirectWav.test.js' --exclude 'tests/unit/essentiaChordTargetedRegression.test.js' --exclude 'tests/unit/essentiaChordJsfingerprintMetrics.test.js' --exclude 'tests/unit/essentiaChordConfusionMetrics.test.js' --exclude 'tests/unit/essentiaChordExtractionSnapshot.test.js'",
    "test:audio": "npm run test:audio:slow",
    "test:audio:slow": "vitest run --testTimeout 60000 tests/unit/pitchLogic.test.js tests/unit/tunerAudio.test.js tests/unit/fastNoteMatcherAudio.test.js tests/unit/fastNoteMatcherSequence.fast.test.js tests/unit/fastNoteMatcherSequence.medium.test.js tests/unit/fastNoteMatcherSequence.slow.test.js tests/unit/sheetMusicSequenceFingerprint.test.js tests/unit/sheetMusicNoteFingerprint.test.js tests/unit/sheetMusicReadingRecognition.test.js tests/unit/notePlayingAudioRegression.test.js tests/unit/d3SubharmonicRegression.test.js",
    "test:audio:chord": "vitest run --testTimeout 60000 tests/unit/essentiaChordAudio.test.js tests/unit/essentiaBassScore.test.js tests/unit/essentiaChordDirectWav.test.js tests/unit/essentiaChordTargetedRegression.test.js tests/unit/essentiaChordJsfingerprintMetrics.test.js tests/unit/essentiaChordConfusionMetrics.test.js tests/unit/essentiaChordExtractionSnapshot.test.js",
    "test:audio:ci": "npm run test:audio:slow",
    "test:ci": "npm run test:precommit",
    "test:e2e": "playwright test",
    "fixtures:chords:introduce": "node scripts/introduce-chord-fixture.mjs",
    "fingerprint": "node scripts/chord-recognition-fingerprint.mjs",
    "fingerprint:fixtures": "node scripts/generate-essentia-fingerprint-fixtures.mjs",
    "jsfingerprint": "node scripts/chord-recognition-jsfingerprint.mjs",
    "notefingerprint": "node scripts/note-recognition-fingerprint.mjs",
    "notefingerprint:goldens": "node scripts/generate-note-analyser-goldens.mjs",
    "sfp": "node scripts/sheet-and-note-fingerprint.mjs",
    "onsetsweep": "node scripts/sheet-onset-sweep.mjs",
    "sheetfingerprint": "node scripts/sheet-music-sequence-fingerprint.mjs",
    "review:android-firefox": "node scripts/build-android-firefox-review-catalog.mjs",
    "lint": "eslint .",
    "prepare": "husky && git config core.hooksPath .husky/_ && git config merge.ours.driver true"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "rolldown": "^1.0.0-rc.15",
    "vitest": "^4.1.2"
  }
}
