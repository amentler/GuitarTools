# Normalize all text files to LF in repo and working copy (cross-platform consistency)
* text=auto eol=lf

# Binary files: no line-ending conversion
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tgz binary
*.gz binary

# version.txt and sw.js are fully auto-generated by scripts/auto-update-version.sh
# during the pre-commit hook. Rebase/merge conflicts in these files are always
# resolved by taking the upstream version and letting the hook regenerate on the
# next commit. Use "ours" so git never blocks a rebase --continue on these files.
version.txt merge=ours
sw.js merge=ours
